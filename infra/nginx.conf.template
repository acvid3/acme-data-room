server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Allow uploads up to the API limit (server default 50MB); nginx default is 1MB.
    client_max_body_size 55m;

    # Resolver for runtime DNS. Render: public DNS. Compose: Docker's built-in DNS.
    resolver ${RESOLVER} valid=30s;

    # API proxy — frontend and API share ONE origin, so the auth cookie
    # (SameSite=Lax, HttpOnly, Secure) is stored and sent correctly.
    location /api/ {
        set $api_host ${API_HOST};
        proxy_pass ${API_SCHEME}://$api_host;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_ssl_server_name on;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
