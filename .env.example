# Copy to .env and adjust. Values here match docker-compose defaults.

# --- Postgres (docker-compose) ---
POSTGRES_USER=dataroom
POSTGRES_PASSWORD=dataroom
POSTGRES_DB=dataroom
POSTGRES_PORT=5432

# --- MinIO / S3 (docker-compose) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=acme-dataroom

# --- API (server/.env) ---
DATABASE_URL=postgresql://dataroom:dataroom@localhost:5432/dataroom?schema=public
# Object storage (S3-compatible). Local dev = MinIO; prod = Backblaze B2 (see infra/CREDENTIALS.md).
# Prod values map into the same S3_* vars:
#   S3_ENDPOINT  = https://s3.<region>.backblazeb2.com
#   S3_REGION    = us-east-1
#   S3_ACCESS_KEY / S3_SECRET_KEY = B2 application keyID / applicationKey (NOT the master key)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=acme-dataroom
# Public base URL for building share/preview links, e.g. http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000
PORT=4000
# Max accepted file size for presigned uploads, in bytes (100 MB)
MAX_FILE_SIZE=104857600

# --- Auth ---
# Email/password auth: set a JWT secret (required).
JWT_SECRET=change-me-in-production
# Google OAuth (optional). Fill after creating a Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend URL for OAuth redirect.
WEB_APP_URL=http://localhost:5173

# --- Web (client/.env) ---
VITE_API_URL=http://localhost:4000

# --- Deployment / CI tooling tokens (NOT read by the app; used by the agent to deploy) ---
# See infra/CREDENTIALS.md. Fill in root .env (never commit).
# Render: dashboard → Account Settings → API Keys → New API Key
RENDER_API_KEY=

# GitHub (optional): fine-grained PAT with repo scope
GH_TOKEN=
